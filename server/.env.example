# Express bridge for PRISM-AI face-recognition AI service
#
# Required for the bridge to persist Python AI detections to Supabase.
# Get these from your Supabase dashboard:
#   Project Settings -> API
#   - SUPABASE_URL: the Project URL
#   - SUPABASE_SECRET_KEY: a Secret key (NOT the publishable one). Bypasses RLS.
#
# NEVER commit the real values. This .env.example file is committed; the
# real .env is gitignored.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Shared secret for the machine-to-machine AI bridge. Python's
# face_recognition.py posts detections to POST /api/attendance with this value
# in the X-API-Key header; requests without it (or with a wrong value) get 401.
# Set the SAME value in the AI process's AI_BRIDGE_KEY environment variable.
AI_BRIDGE_KEY=change-me-to-a-long-random-string
